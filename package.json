{
    "name": "@openhps/core",
    "version": "1.0.16",
    "description": "Open Hybrid Positioning System - Core component",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenHPS/openhps-core.git"
    },
    "bugs": {
        "url": "https://github.com/OpenHPS/openhps-core/issues"
    },
    "homepage": "https://openhps.org",
    "publishConfig": {
        "access": "public"
    },
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "module": "./dist/esm/index.js",
    "es2015": "./dist/esm/index.js",
    "unpkg": "./dist/web/openhps-core.min.js",
    "jsdelivr": "./dist/web/openhps-core.min.js",
    "browser": {
        "typescript": false,
        "microtime": false
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./internal": {
            "import": {
                "types": "./dist/esm/index.internal.d.ts",
                "default": "./dist/esm/index.internal.js"
            },
            "require": {
                "types": "./dist/types/index.internal.d.ts",
                "default": "./dist/cjs/index.internal.js"
            }
        },
        "./worker": {
            "import": {
                "types": "./dist/esm/worker/WorkerRunner.d.ts",
                "default": "./dist/esm/worker/WorkerRunner.js"
            },
            "require": {
                "types": "./dist/types/worker/WorkerRunner.d.ts",
                "default": "./dist/cjs/worker/WorkerRunner.js"
            }
        },
        "./lite": {
            "import": {
                "types": "./dist/esm/index.lite.d.ts",
                "default": "./dist/esm/index.lite.js"
            },
            "require": {
                "types": "./dist/types/index.lite.d.ts",
                "default": "./dist/cjs/index.lite.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "LICENSE",
        "internal.js",
        "internal.ts",
        "internal.d.ts",
        "lite.js",
        "lite.ts",
        "lite.d.ts"
    ],
    "size-limit": [
        {
            "path": "./dist/web/openhps-core.min.js",
            "limit": "70 KB",
            "brotli": true
        },
        {
            "path": "./dist/web/openhps-core.es.min.js",
            "limit": "70 KB",
            "brotli": true
        },
        {
            "path": "./dist/web/openhps-core-lite.min.js",
            "limit": "66 KB",
            "brotli": true
        },
        {
            "path": "./dist/web/worker.openhps-core.min.js",
            "limit": "18 KB",
            "brotli": true
        }
    ],
    "scripts": {
        "examples": "shx cp node_modules/@openhps/*/dist/web/*.* examples/common/ && shx cp dist/web/*.* examples/common/ && serve ./examples",
        "test": "mocha --config test/.mocharc.json",
        "benchmark": "ts-node test/bench/worker.bench.ts",
        "cover": "c8 mocha --config test/.mocharc.json",
        "cover:ci": "c8 mocha --config test/.mocharc.ci.json && c8 report --reporter=cobertura",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "size": "size-limit",
        "clean": "shx rm -rf ./dist && shx rm -rf ./docs/out",
        "build": "npm run clean && npm run build:three && npm-run-all --parallel build:ts:* && npm run build:webpack",
        "build:quick": "npm-run-all --parallel build:ts:* && npm run build:webpack",
        "build:typedoc": "typedoc --options docs/typedoc.json --plugin typedoc-umlclass",
        "build:three": "node ./scripts/build.three.js",
        "build:ts:cjs": "tsc --build ./tsconfig/tsconfig.bundle.cjs.json",
        "build:ts:esm": "tsc --build ./tsconfig/tsconfig.bundle.esm.json && node ./scripts/finalize-esm.mjs",
        "build:ts:types": "tsc --build ./tsconfig/tsconfig.bundle.types.json",
        "build:webpack": "npm-run-all --parallel build:webpack:*",
        "build:webpack:prod": "webpack --env prod --",
        "build:webpack:dev": "webpack --env dev --",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:beta": "commit-and-tag-version --prerelease beta -m 'chore(beta): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog",
        "build:paper": "docker run --rm --volume docs/paper:/data --env JOURNAL=joss openjournals/inara",
        "prepare": "husky"
    },
    "keywords": [
        "vrije universiteit brussel",
        "wise",
        "openhps",
        "hybrid",
        "positioning",
        "system",
        "indoor",
        "outdoor",
        "multilateration",
        "triangulation",
        "fingerprinting",
        "dead reckoning"
    ],
    "dependencies": {
        "reflect-metadata": ">=0.2.2",
        "threads": "^1.7.0",
        "tslib": "^2.9.1",
        "typedjson": "^1.8.0",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@babel/core": "^8.1.2",
        "@babel/preset-env": "^8.0.7",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^9.34.0",
        "@size-limit/file": "^14.3.0",
        "@types/benchmark": "^2.1.5",
        "@types/chai": "^5.2.2",
        "@types/deasync": "^0.1.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "@types/three": "^0.185.4",
        "benchmark": "^2.1.4",
        "c8": "^12.0.0",
        "chai": "^6.3.0",
        "commit-and-tag-version": "^13.3.0",
        "csv-parser": "^3.0.0",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "microtime": "^3.1.1",
        "mocha": "^11.8.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.2",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.10.0",
        "serve": "^14.2.7",
        "shx": "^0.4.0",
        "size-limit": "^14.3.0",
        "terser-webpack-plugin": "^5.3.14",
        "three": "^0.185.1",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typedoc-umlclass": "^0.10.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "webpack": "^5.112.2",
        "webpack-cli": "^7.3.1",
        "webpack-inject-plugin": "^1.5.5"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2"
}
