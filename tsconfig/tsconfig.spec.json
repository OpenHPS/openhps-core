{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "ES6",
        "module": "commonjs",
        "moduleResolution": "node",
        "noImplicitAny": false,
        "removeComments": true,
        "preserveConstEnums": true,
        "declaration": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "strict": false
    },
    "ts-node": {
        "transpileOnly": false,
        "files": true
    },
    "include": ["../test/**/*.ts"]
}
